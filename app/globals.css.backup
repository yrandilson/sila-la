@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --font-display: 'Syne', sans-serif;
  --font-body: 'Space Mono', monospace;

  --bg-primary: #f8f9fb;
  --bg-secondary: #ffffff;
  --text-primary: #0f1419;
  --text-secondary: #626270;
  --border-color: #e1e4e8;
  --accent: #ff6b35;
  --accent-dark: #e55a1a;
  --accent-light: #ffd9cc;
  --teal: #0f7c79;
  
  --shadow-sm: 0 1px 3px rgba(15, 20, 25, 0.08);
  --shadow-md: 0 4px 12px rgba(15, 20, 25, 0.12);
  --shadow-lg: 0 8px 24px rgba(15, 20, 25, 0.15);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  min-height: 100vh;
}

body {
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  line-height: 1.5;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.01em;
}

a {
  text-decoration: none;
  color: inherit;
}

input, button, select {
  font-family: inherit;
}

.store-container {
  width: min(1240px, calc(100% - 2rem));
  margin: 0 auto;
}

/* HEADER */
.store-header {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 40;
  box-shadow: var(--shadow-sm);
}

.header-top {
  padding: 0.75rem 0;
}

.nav-top-row {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  justify-content: space-between;
}

.store-logo {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 800;
  min-width: fit-content;
}

.store-logo span {
  color: var(--accent);
}

.search-bar {
  flex: 1;
  max-width: 360px;
  position: relative;
  display: flex;
  align-items: center;
  background: #f3f5f7;
  border-radius: 8px;
  border: 1px solid #e8eaed;
  padding: 0.5rem 1rem;
}

.search-icon {
  color: var(--text-secondary);
  margin-right: 0.5rem;
}

.search-input {
  flex: 1;
  background: none;
  border: 0;
  outline: 0;
  font-size: 0.9rem;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.icon-btn {
  width: 36px;
  height: 36px;
  border-radius: 6px;
  border: 1px solid var(--border-color);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  position: relative;
}

.icon-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.badge {
  position: absolute;
  top: -6px;
  right: -6px;
  background: var(--accent);
  color: #fff;
  font-size: 0.65rem;
  font-weight: 700;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-sm {
  padding: 0.5rem 1rem;
  background: transparent;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-sm:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.header-bottom {
  border-top: 1px solid var(--border-color);
  padding: 0.5rem 0;
  overflow-x: auto;
}

.category-nav {
  display: flex;
  gap: 0.5rem;
  white-space: nowrap;
}

.cat-btn {
  padding: 0.5rem 1rem;
  background: transparent;
  border: 0;
  color: var(--text-secondary);
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 600;
  border-bottom: 2px solid transparent;
  transition: all 0.2s ease;
}

.cat-btn:hover,
.cat-btn.active {
  color: var(--accent);
  border-bottom-color: var(--accent);
}

/* HERO BANNER */
.hero-banner {
  background: linear-gradient(135deg, #ff6b35 0%, #ffa366 100%);
  padding: 3rem 0;
  margin-bottom: 1.5rem;
  position: relative;
  overflow: hidden;
}

.hero-banner::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300px;
  height: 300px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  transform: translate(80px, -80px);
}

.banner-content {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #fff;
}

.banner-content h1 {
  font-size: clamp(1.8rem, 5vw, 2.8rem);
  margin-bottom: 0.5rem;
}

.banner-content span {
  display: block;
  font-style: italic;
  opacity: 0.95;
}

.banner-content p {
  font-size: 1rem;
  margin-bottom: 1.5rem;
  opacity: 0.9;
}

.btn-primary-lg {
  background: #fff;
  color: var(--accent);
  border: 0;
  padding: 0.75rem 2rem;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-primary-lg:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
}

/* TRUST SECTION */
.trust-section {
  background: var(--bg-secondary);
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  padding: 1.5rem 0;
  margin-bottom: 2rem;
}

.trust-items {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 2rem;
  text-align: center;
}

.trust-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.7rem;
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.trust-item svg {
  color: var(--accent);
  flex-shrink: 0;
}

.shield-icon {
  font-size: 1.2rem;
}

/* PRODUCTS SECTION */
.products-section {
  padding: 2rem 0;
}

.products-wrapper {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 2rem;
}

/* FILTERS SIDEBAR */
.filters-sidebar {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 1rem;
  height: fit-content;
  position: sticky;
  top: 90px;
}

.filter-title {
  font-size: 1rem;
  margin-bottom: 1rem;
  font-family: var(--font-display);
}

.filter-group {
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border-color);
}

.filter-group:last-child {
  border-bottom: 0;
  margin-bottom: 0;
  padding-bottom: 0;
}

.filter-label {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 0.6rem;
  color: var(--text-primary);
}

.filter-select {
  width: 100%;
  padding: 0.5rem 0.7rem;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  background: #fff;
  font-size: 0.85rem;
  cursor: pointer;
}

.price-range {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.range-input {
  width: 100%;
}

.price-display {
  display: flex;
  justify-content: space-between;
  font-size: 0.8rem;
  color: var(--text-secondary);
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.6rem;
  cursor: pointer;
  font-size: 0.85rem;
}

.checkbox-label input {
  cursor: pointer;
}

/* PRODUCTS GRID */
.products-main {
  flex: 1;
}

.empty-catalog {
  text-align: center;
  padding: 3rem 2rem;
  background: var(--bg-secondary);
  border: 2px dashed var(--border-color);
  border-radius: 8px;
}

.empty-title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  margin-bottom: 0.5rem;
}

.empty-desc {
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border: 0;
  padding: 0.6rem 1.4rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-block;
}

.btn-primary:hover {
  background: var(--accent-dark);
  transform: translateY(-1px);
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1.2rem;
}

.product-item {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  overflow: hidden;
  transition: all 0.25s ease;
  display: flex;
  flex-direction: column;
}

.product-item:hover {
  border-color: var(--accent);
  box-shadow: var(--shadow-md);
  transform: translateY(-4px);
}

.product-image-wrapper {
  position: relative;
  background: linear-gradient(135deg, #fff3ed 0%, #f0f8f7 100%);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-image {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
}

.product-emoji {
  display: block;
}

.wishlist-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.wishlist-btn:hover {
  background: #fff;
  color: var(--accent);
}

.promo-badge {
  position: absolute;
  top: 8px;
  left: 8px;
  background: var(--accent);
  color: #fff;
  padding: 0.3rem 0.7rem;
  border-radius: 20px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
}

.product-details {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.product-name {
  font-size: 0.95rem;
  margin-bottom: 0.4rem;
  line-height: 1.35;
  color: var(--text-primary);
}

.product-desc {
  font-size: 0.8rem;
  color: var(--text-secondary);
  margin-bottom: 0.7rem;
  line-height: 1.4;
  flex: 1;
}

.product-rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.7rem;
  font-size: 0.8rem;
}

.stars {
  display: flex;
  gap: 0.2rem;
}

.stars svg {
  width: 14px;
  height: 14px;
  color: #ddd;
}

.stars svg.filled {
  color: #ffc107;
  fill: #ffc107;
}

.rating-count {
  color: var(--text-secondary);
  font-size: 0.75rem;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 0.8rem;
}

.product-tag {
  display: inline-block;
  background: #f3f5f7;
  color: #626270;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.7rem;
}

.product-footer {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: flex-end;
  gap: 0.7rem;
  border-top: 1px solid var(--border-color);
  padding-top: 0.8rem;
  margin-top: auto;
}

.price-label {
  display: block;
  font-size: 0.7rem;
  color: var(--text-secondary);
  margin-bottom: 0.2rem;
}

.product-price {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--accent);
}

.product-actions {
  display: flex;
  gap: 0.5rem;
}

.btn-add-cart {
  flex: 1;
  background: var(--accent);
  color: #fff;
  border: 0;
  padding: 0.5rem 0.75rem;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  text-decoration: none;
  text-align: center;
}

.btn-add-cart:hover {
  background: var(--accent-dark);
  transform: translateY(-1px);
}

.btn-demo {
  width: 36px;
  height: 36px;
  border: 1px solid var(--border-color);
  background: #fff;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  transition: all 0.2s ease;
}

.btn-demo:hover {
  border-color: var(--accent);
  background: var(--accent-light);
}

/* FOOTER */
.store-footer {
  background: var(--text-primary);
  color: #fff;
  padding: 3rem 0 1rem;
  margin-top: 3rem;
}

.footer-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 2rem;
  margin-bottom: 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-col {
}

.footer-title {
  font-family: var(--font-display);
  font-size: 1rem;
  margin-bottom: 1rem;
}

.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.footer-links a {
  color: #ccc;
  font-size: 0.9rem;
  transition: color 0.2s ease;
}

.footer-links a:hover {
  color: var(--accent);
}

.footer-desc {
  font-size: 0.9rem;
  color: #ccc;
  margin-bottom: 0.8rem;
  line-height: 1.5;
}

.newsletter-form {
  display: flex;
  gap: 0.5rem;
}

.newsletter-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 6px;
  padding: 0.6rem 0.8rem;
  color: #fff;
  font-size: 0.85rem;
}

.newsletter-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.btn-primary-sm {
  background: var(--accent);
  color: #fff;
  border: 0;
  padding: 0.6rem 1rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.btn-primary-sm:hover {
  background: var(--accent-dark);
  transform: translateY(-1px);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  font-size: 0.85rem;
  color: #ccc;
}

.footer-copy {
}

.payment-methods {
  display: flex;
  gap: 1.5rem;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .products-wrapper {
    grid-template-columns: 1fr;
  }

  .filters-sidebar {
    position: static;
    display: none;
  }

  .products-grid {
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
}

@media (max-width: 768px) {
  .nav-top-row {
    gap: 1rem;
    flex-wrap: wrap;
  }

  .search-bar {
    max-width: 100%;
    order: 3;
    flex-basis: 100%;
  }

  .category-nav {
    flex-wrap: wrap;
  }

  .cat-btn {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
  }

  .products-grid {
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.8rem;
  }

  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-bottom {
    flex-direction: column;
    text-align: center;
  }
}

@media (max-width: 480px) {
  .store-logo {
    font-size: 1.2rem;
  }

  .search-bar {
    display: none;
  }

  .nav-actions {
    gap: 0.4rem;
  }

  .icon-btn {
    width: 32px;
    height: 32px;
  }

  .btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
  }

  .hero-banner {
    padding: 2rem 0;
  }

  .banner-content h1 {
    font-size: 1.5rem;
  }

  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }

  .product-item {
    border-radius: 8px;
  }

  .product-name {
    font-size: 0.85rem;
  }

  .product-price {
    font-size: 1.1rem;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }
}
